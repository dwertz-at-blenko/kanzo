[Unit]
# systemd USER unit: cloudflared for tunnel kanzo (kanzo.blenko.cloud). No sudo to install.
Description=cloudflared tunnel kanzo (kanzo.blenko.cloud)
After=network-online.target kanzo-web.service
Wants=network-online.target
Requires=kanzo-web.service

[Service]
Type=simple
# The launcher reads the run token from ~/.cloudflared/kanzo.json (0600) and exports
# it as TUNNEL_TOKEN, so no credential appears in a process listing.
ExecStart=/home/claude/dev/kanzo/deploy/tunnel-exec.sh
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=default.target
