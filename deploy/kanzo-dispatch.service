# Version: v3 · created 2026-11-21 13:26 EST · updated 2026-11-28 15:12 EST
# Changes: v1 user unit for kanzo-dispatch (comment @claude on a card to start a session).
#          v2 2026-11-24 start through deploy/run-dispatch.sh, which brings the Web Push key from the vault.
#          v3 2026-11-28 ExecStop ends the dispatcher itself: since v2 the main process is `bws`, and a
#          restart left the old dispatcher running beside the new one.
# This file: /home/claude/dev/kanzo/deploy/kanzo-dispatch.service (repo dwertz-at-blenko/kanzo, branch public-url)
# Session: b1475961-06d7-40b0-9eff-f2b47896b6bb · vps as claude · cwd /home/claude/dev
[Unit]
# systemd USER unit. Linger is enabled for `claude`, so it starts at boot. Install:
#   ln -sf ~/dev/kanzo/deploy/kanzo-dispatch.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now kanzo-dispatch
# It reads the board on loopback, writes through the board's /mcp as kanzo-dispatch, and runs
# `claude`, which uses this user's own Claude login. Its one secret is the Web Push key
# (KANZO_VAPID_PRIVATE_KEY), injected by deploy/run-dispatch.sh under `bws run`; the dispatcher
# takes it out of its environment at start. Without the vault it starts with push off.
Description=kanzo-dispatch: start a Claude session from a Kanzo card comment
After=kanzo-web.service
Wants=kanzo-web.service

[Service]
Type=simple
WorkingDirectory=/home/claude/dev/kanzo
Environment=KANZO_HOME=/home/claude/.local/share/kanzo
Environment=PATH=/home/claude/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/claude/dev/kanzo/deploy/run-dispatch.sh --loop --interval 5 --board http://127.0.0.1:8111 --dev-root /home/claude/dev --max 3
Restart=on-failure
RestartSec=10
# Background sessions run under `claude daemon run`, which `claude --bg` launches when it is not
# already up. Started from here, it would sit in this unit's cgroup, and a restart would kill
# every background session on the box. Stop only the dispatcher itself.
KillMode=process
# The main process is `bws run`, which does not pass SIGTERM on to the dispatcher under it.
ExecStop=/home/claude/dev/kanzo/deploy/run-dispatch.sh --stop
# No PrivateTmp: the claude daemon's sockets live in /tmp/cc-daemon-<uid>, and so does the
# dispatcher's private tmux socket.

NoNewPrivileges=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=default.target
